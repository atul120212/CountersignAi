# ---------------------------------------------------------------------------
# Local quick start (memory store, shared demo workspace, real Gemini):
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Vercel (see DEPLOY_VERCEL.md):
# GEMINI_API_KEY=...
# GCP_SERVICE_ACCOUNT_JSON=<base64 of the Firebase service-account key>   -> Firestore storage
# FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}   (optional: sign-in + live listeners)

# ---------------------------------------------------------------------------
# Cloud Run (set automatically by infra/deploy.sh):
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_GENAI_USE_VERTEXAI=true
# GEMINI_LOCATION=global
# GEMINI_FLASH_MODEL=gemini-3.5-flash
# STORE_BACKEND=firestore
# AUTH_MODE=firebase
# GCS_BUCKET=my-project-operateguard-docs
# BQ_AUDIT_TABLE=my-project.operateguard.audit_log
# FIREBASE_WEB_CONFIG={...}

# Optional tuning
# GEMINI_AUDIT_MODEL=gemini-3.5-flash
# GEMINI_THINKING_LEVEL=low
# USE_EMBEDDINGS=true
# MAX_UPLOAD_MB=15
# RUNS_PER_HOUR=40
